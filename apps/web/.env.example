# Frontend (browser-safe - only VITE_* vars are exposed by Vite)
# Never put server secrets (SUPABASE_SERVICE_ROLE_KEY, PARA_WALLET_PRIVATE_KEY, etc.) here.

# API base URL for ChronicleAI backend
VITE_API_BASE_URL=http://localhost:4000

# Optional Supabase browser client (if used)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: MPP machine-client shared secret for premium settlement UI.
# Must match the API server MPP_SECRET / MPP_SECRET_KEY.
# Prefer machine clients over putting secrets in public web builds when possible.
VITE_MPP_CLIENT_SECRET=
