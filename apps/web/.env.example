# Frontend (browser-safe - only VITE_* vars are exposed by Vite)
# Never put server secrets (SUPABASE_SERVICE_ROLE_KEY, PARA_WALLET_PRIVATE_KEY, etc.) here.

# API base URL for ChronicleAI backend
VITE_API_BASE_URL=http://localhost:4000

# Optional Supabase browser client (if used)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put MPP_SECRET (or any HMAC/payment secret) in VITE_* — public after build.
# MPP HMAC is computed only by server-side machine clients holding MPP_SECRET.
