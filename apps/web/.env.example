# Frontend (browser-safe - only VITE_* vars are exposed by Vite)
# Never put server secrets here, including:
#   SUPABASE_SERVICE_ROLE_KEY, PARA_API_KEY, PARA_WALLET_ID, PARA_WALLET_PRIVATE_KEY,
#   TREASURY_WALLET_PRIVATE_KEY, KEEPERHUB_API_KEY, MPP_SECRET, etc.
# Para MPC treasury vars belong in apps/api/.env or the root .env only.

# API base URL for ChronicleAI backend
VITE_API_BASE_URL=http://localhost:4000

# Optional Supabase browser client (if used)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# x402 payment chain (must match server X402_CHAIN_ID). Default: Base Sepolia.
VITE_X402_CHAIN_ID=84532
# Optional public RPC used when adding the chain to a browser wallet
VITE_X402_RPC_URL=https://sepolia.base.org

# WalletConnect Cloud project id (public). Free at https://cloud.reown.com
# Required for WalletConnect / mobile wallets in the connect modal.
# Injected wallets (MetaMask extension) work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# Never put MPP_SECRET (or any HMAC/payment secret) in VITE_* — public after build.
# MPP HMAC is computed only by server-side machine clients holding MPP_SECRET.
