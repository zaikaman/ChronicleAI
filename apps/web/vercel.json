{
  "framework": "vite",
  "installCommand": "cd ../.. && corepack enable && corepack prepare pnpm@10.7.1 --activate && pnpm install --filter @chronicleai/web... --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @chronicleai/web run build:vercel",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ./ ../../packages/schemas ../../packages/config ../../pnpm-lock.yaml ../../package.json ../../pnpm-workspace.yaml"
}
