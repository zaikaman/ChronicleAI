{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@chronicleai/schemas": ["../../packages/schemas/src"],
      "@chronicleai/schemas/*": ["../../packages/schemas/src/*"],
      "@chronicleai/config": ["../../packages/config/src"],
      "@chronicleai/config/*": ["../../packages/config/src/*"],
      "@chronicleai/db": ["../../packages/db/src"],
      "@chronicleai/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
