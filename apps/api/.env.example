# Backend (server-only - never expose these values in frontend or client code)
# Loaded via packages/config loadServerEnv() and related process.env reads.

NODE_ENV=development
PORT=4000

# Required
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KEEPERHUB_WEBHOOK_SECRET=
# Public SPA origin for on-chain contentUri (alerts, digests, tickets, premium receipts).
# Local: http://localhost:5173. Production MUST be https and non-localhost.
FRONTEND_ORIGIN=http://localhost:5173

# Optional / tooling
SUPABASE_ANON_KEY=

# LLM Provider API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Host only — do NOT append /v1beta (the Google SDK adds apiVersion itself).
# Example proxy: https://v98store.com
GEMINI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=

# Payments (x402 + MPP) — dual-rail: pay on Base Sepolia, desk on Ethereum Sepolia
# Facilitator settle endpoint base.
# - CDP: https://api.cdp.coinbase.com/platform/v2/x402 — requires CDP_API_KEY_ID + CDP_API_KEY_SECRET
# - Public testnet: https://x402.org/facilitator — no auth (supported testnets)
# When set, x402 settlements POST /settle to submit EIP-3009 transferWithAuthorization.
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# Coinbase Developer Platform Secret API Key (portal → API keys). Required for CDP facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# x402 EIP-712 domain: chain + USDC verifyingContract (defaults = Base Sepolia).
# Base mainnet: X402_CHAIN_ID=8453, X402_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_CHAIN_ID=84532
X402_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Sepolia RPC for receipt checks / direct settle (do not reuse desk RPC_URL).
X402_RPC_URL=https://sepolia.base.org
# Alias accepted: BASE_SEPOLIA_RPC_URL
# Desk / capital manager USDC on Ethereum Sepolia (Circle) — never Base payment USDC.
DESK_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# EIP-712 domain for TransferWithAuthorization — MUST match on-chain USDC.
# Circle Base Sepolia USDC name is "USDC". Base mainnet: "USD Coin".
# Leave unset to auto-pick from chain id.
# X402_USDC_EIP712_NAME=USDC
# X402_USDC_EIP712_VERSION=2
# Shared HMAC secret for MPP challenge verification
MPP_SECRET=
# HMAC secret for premium access receipts (min 16 chars). Falls back to KEEPERHUB_WEBHOOK_SECRET.
PREMIUM_ACCESS_SECRET=
# Recurring x402 monthly newsletter (USDC human units, billing period, grace)
NEWSLETTER_MONTHLY_PRICE_USDC=2
NEWSLETTER_BILLING_PERIOD_DAYS=30
NEWSLETTER_GRACE_PERIOD_DAYS=3
# Treasury: receives x402 payments. Production spends use Para MPC (below).
# TREASURY_WALLET_PRIVATE_KEY is local-test only; ADDRESS optional (must match key or Para wallet).
# With RPC_URL, a settlement key may pay gas for direct transferWithAuthorization
# when no facilitator is configured (signature alone never unlocks premium).
TREASURY_WALLET_PRIVATE_KEY=
TREASURY_WALLET_ADDRESS=
# Minimum treasury balance (ETH) for registry writes / revenue routing. Default 0.01.
TREASURY_SAFETY_BUFFER=0.01
# USDC retained as operating reserve before Loop 5 distribution (default 0).
# Demo: keep 0 (or low) so micro-payouts can fire when excess balance exists.
TREASURY_USDC_OPERATING_RESERVE=0
# Creator recovery payout RECIPIENT address (no private key; distinct from treasury)
CREATOR_RECOVERY_WALLET=
# ── Transparent revenue-routing policy (Loop 5 / IDEA circular economy) ──
# Max fraction of distributable revenue for creator/deployer recovery (0–1). Default 0.8.
CREATOR_RECOVERY_SHARE=0.8
# Affiliate eligibility comes from the product `affiliates` registry (POST /affiliates),
# not env. Caps still apply to how much of distributable revenue can go to partners.
# Max share of distributable revenue for affiliates combined (0–1). Default 0.2.
REFERRAL_REWARD_SHARE=0.2
# Absolute currency-unit cap on total affiliate rewards per routing period.
REFERRAL_REWARD_CAP=1000
# Max fraction of (available − safety buffer) to distribute per period (0–1). Default 0.5.
MAX_PAYOUT_SHARE=0.5
# Minimum net distributable USDC before a payout is created (default 0.01).
# Allows sub-dollar micro-payouts for hackathon demo cadence.
REVENUE_MIN_DISTRIBUTABLE_USDC=0.01
# Minimum ms between autonomous routing runs (default 7 days = 604800000).
# Demo cadence: set 3600000 (1h) so ≥3 micro-payouts can fire in a demo week.
ROUTING_INTERVAL_MS=604800000
# In-process Loop 5 scheduler (still gated by ROUTING_INTERVAL_MS + safety buffer).
REVENUE_ROUTING_SCHEDULE_ENABLED=true
# How often the revenue-routing scheduler wakes (default 1 hour = 3600000).
REVENUE_ROUTING_SCHEDULE_INTERVAL_MS=3600000
# Revenue FX: oracle = require Chainlink ETH/USD; static = fixed scale only;
# auto = Chainlink with static fallback (default). Needs RPC_URL for oracle/auto.
REVENUE_FX_MODE=auto
# Static ETH-per-currency-unit scale (required for static mode; auto fallback).
# Live oracle: ethAmount = currencyUnits / ethUsdPrice when Chainlink is available.
REVENUE_ETH_PER_CURRENCY_UNIT=0.000001

# ── Loop 3 treasury-check schedule (in-process weekly maintenance) ──
# When true (default), records Para/RPC balance + utility metrics without external cron.
TREASURY_CHECK_SCHEDULE_ENABLED=true
# How often the treasury-check scheduler wakes (default 1 hour = 3600000).
TREASURY_CHECK_SCHEDULE_INTERVAL_MS=3600000
# Minimum gap between successful snapshots from the in-process scheduler (default 7 days).
TREASURY_CHECK_MIN_INTERVAL_MS=604800000
# USDC-equivalent cost estimates used for Loop 3 utility audits / Loop 5 cost subtraction.
UTILITY_COST_PER_GENERATION_USDC=0.02
UTILITY_COST_PER_REGISTRY_WRITE_USDC=0.05

# ── Loop 4 sponsored watch product (custom campaign purchase) ──
# USDC price for buyer-submitted sponsored monitoring campaigns.
SPONSORED_WATCH_PRICE_USDC=1
# Default campaign length in days when endsAt is omitted.
SPONSORED_WATCH_DEFAULT_DURATION_DAYS=7
# Max campaign length a buyer may request (days).
SPONSORED_WATCH_MAX_DURATION_DAYS=90
# Minimum campaign length in hours (hackathon short demo = 1).
# Buyers may set durationHours ≥ this (or endsAt within the window).
SPONSORED_WATCH_MIN_DURATION_HOURS=1

# ── Para MPC treasury (PRODUCTION) ──────────────────────────────────
# Partner API key from https://developer.getpara.com (server-side only).
# When set, ChronicleAI enrolls/loads a real Para MPC EVM treasury wallet
# and signs revenue transfers via Para REST (no private key in process).
PARA_API_KEY=
# BETA (default, testnets) | PROD | SANDBOX
PARA_ENVIRONMENT=BETA
# Stable identifier for the agent treasury wallet (CUSTOM_ID by default)
PARA_TREASURY_USER_IDENTIFIER=chronicleai-treasury
PARA_TREASURY_USER_IDENTIFIER_TYPE=CUSTOM_ID
# Optional: pin an existing Para wallet id (skips create/list)
PARA_WALLET_ID=

# Smart Contract / KeeperHub Write Path
# Preferred production: PARA_API_KEY (treasury) + KEEPERHUB_* (registry writes).
# RPC_URL is used for read-only block analysis + Para-only registry path + Chainlink ETH/USD.
RPC_URL=
CHRONICLE_REGISTRY_ADDRESS=
# KeeperHub workflow trigger for registry writes
KEEPERHUB_API_BASE_URL=https://app.keeperhub.com
KEEPERHUB_API_KEY=
# Network slug for KeeperHub writes (default sepolia / 11155111)
KEEPERHUB_NETWORK=sepolia
# Required: imported KeeperHub workflow IDs (one per JSON under workflows/keeperhub/).
# Each write action fails hard if its workflow ID is unset.
#   chronicle-publish-alert.workflow.json
KEEPERHUB_WORKFLOW_PUBLISH_ALERT=
#   chronicle-publish-digest.workflow.json
KEEPERHUB_WORKFLOW_PUBLISH_DIGEST=
#   chronicle-create-sponsored-watch.workflow.json
KEEPERHUB_WORKFLOW_CREATE_SPONSORED_WATCH=
#   chronicle-publish-sponsored-report.workflow.json
KEEPERHUB_WORKFLOW_PUBLISH_SPONSORED_REPORT=
#   chronicle-publish-premium-receipt.workflow.json
KEEPERHUB_WORKFLOW_PUBLISH_PREMIUM_RECEIPT=
#   chronicle-record-payout.workflow.json
KEEPERHUB_WORKFLOW_RECORD_PAYOUT=
#   chronicle-publish-trade-ticket.workflow.json
KEEPERHUB_WORKFLOW_PUBLISH_TRADE_TICKET=
#   chronicle-record-capital-move.workflow.json
KEEPERHUB_WORKFLOW_RECORD_CAPITAL_MOVE=
#   chronicle-revenue-transfer.workflow.json
KEEPERHUB_WORKFLOW_TRANSFER=
# Desk strategy + capital workflows (import JSON under workflows/keeperhub/)
#   desk-sweep.workflow.json
KEEPERHUB_WORKFLOW_DESK_SWEEP=
#   desk-defend.workflow.json
KEEPERHUB_WORKFLOW_DESK_DEFEND=
#   desk-rotate-yield.workflow.json
KEEPERHUB_WORKFLOW_DESK_ROTATE=
#   desk-oracle-arb.workflow.json
KEEPERHUB_WORKFLOW_DESK_ORACLE_ARB=
#   desk-kill-switch.workflow.json
KEEPERHUB_WORKFLOW_DESK_KILL_SWITCH=
# Direct ethers sendTransaction is HARD-DISABLED in production.
# Set true only for local unit tests (never ship with this in demo/prod).
ALLOW_DIRECT_ETHERS_WRITES=false
# Test-only agent/registry EOA (historical name — NOT Para MPC).
# Only used when ALLOW_DIRECT_ETHERS_WRITES=true (local tests).
# Also used by packages/contracts Hardhat deploy as the deployer key.
PARA_WALLET_PRIVATE_KEY=
# Optional: Hardhat verify / contract tooling (Ethereum Sepolia primary)
ETHERSCAN_API_KEY=
# Legacy Base Sepolia verify only
BASESCAN_API_KEY=
# KH desk wallet — grant as ChronicleRegistry operator after deploy (public address only; never a private key)
DESK_WALLET_ADDRESS=
#
# ── Private routing policy (KEEP-137 / Flashbots Protect · Sepolia only) ──
# Material KH write nodes set usePrivateMempool in workflow JSON; these env vars
# control Chronicle policy (desk preference, treasury path selection, registry,
# UI/log labels). Private RPC URL is configured in KeeperHub CHAIN_RPC_CONFIG —
# never hardcode https://rpc-sepolia.flashbots.net/ here.
# Docs: workflows/keeperhub/README.md § Private routing
#       docs/private-routing-implementation-plan.md
#
# Prefer private mempool for desk strategy/capital KH executions (default on).
DESK_USE_PRIVATE_MEMPOOL=true
# Expect workflow strict mode (private RPC failure does not fall back to public).
# Kill-switch residual transfers always strict regardless of this flag.
DESK_PRIVATE_MEMPOOL_STRICT=true
# USDC notional at/above this forces KeeperHub private transfer path (not Para alone).
TREASURY_PRIVATE_TRANSFER_THRESHOLD_USDC=50
# Registry publish/record workflows: true = full-stack private; false = leave public
# for gas sponsorship when demo gas credits matter.
REGISTRY_USE_PRIVATE_MEMPOOL=true
# Provider label for Activity / execution_logs (not a network endpoint).
ROUTING_PROVIDER_LABEL=flashbots_protect
# NOTE: Private route disables KH gas sponsorship — fund DESK_WALLET with Sepolia ETH.
#
# Desk policy — sized for funded Sepolia demo book (~$1k Aave inventory).
# Sweeps never take free USDC below DESK_MIN_FREE_USDC (powder reserve).
DESK_TARGET_AUM_USDC=1000
DESK_MAX_AUM_USDC=2000
DESK_MIN_AUM_USDC=200
DESK_TOPUP_CHUNK_USDC=10
# Min liquid free USDC on desk (inventory floor for new risk-increasing trades)
DESK_MIN_FREE_USDC=10
# Chunk to free via unwind (or treasury inventory top-up) when free USDC is below floor
DESK_INVENTORY_TOPUP_USDC=10
# Prefer on-desk Aave/free-LINK unwind over treasury mint when free USDC is short
DESK_PREFER_UNWIND_FOR_FREE_USDC=true
# APY |edge| (bps) above this is data-quality unreliable (not a yield thesis)
DESK_APY_ABSURD_BPS=5000
# Min ms between maintenance rebalance fills (default 6h)
DESK_REBALANCE_INTERVAL_MS=21600000
# Notional cap for maintenance free-powder / rebalance legs (USDC)
DESK_MAINTENANCE_NOTIONAL_USDC=10
# After free-powder maintenance fill, skip max-AUM sweeps for this long (ms)
# unless free is well above minFree + profit threshold (anti-thrash).
DESK_POST_MAINTENANCE_SWEEP_COOLDOWN_MS=1200000
# Event-linked microtrade (newspaper large_swap / gas_spike → desk). On by default.
# ≤1 policy-capped KH execution per cooldown with reason event_linked_microtrade.
# Set false to disable.
DESK_EVENT_MICROTRADE_ENABLED=true
DESK_EVENT_MICROTRADE_USDC=5
DESK_EVENT_MICROTRADE_COOLDOWN_MS=3600000
# DESK_EVENT_MICROTRADE_LOOKBACK_MS=3600000
DESK_PROFIT_SWEEP_USDC=15
DESK_TOPUP_COOLDOWN_MS=3600000
DESK_HF_WARN=1.5
DESK_HF_CRITICAL=1.2
DESK_BASIS_BPS=50
DESK_APY_DELTA_BPS=50
DESK_MAX_TRADE_USDC=15
DESK_KILL_HEARTBEAT_MS=21600000
DESK_PAUSED=false
# In-process autonomous loop: capital manager + strategy tick (default on)
# Wake every 15m; execute=true runs KeeperHub workflows for approved intents
DESK_SCHEDULE_ENABLED=true
DESK_SCHEDULE_INTERVAL_MS=900000
DESK_SCHEDULE_EXECUTE=true
# Optional: failed-run cooldown, oracle staleness, APY consecutive polls, gas elevated gwei
# DESK_FAILED_RUN_COOLDOWN_MS=900000
# DESK_ORACLE_MAX_STALENESS_MS=3600000
# DESK_APY_CONSECUTIVE_POLLS=2
# DESK_GAS_ELEVATED_GWEI=50
# Premium x402 desk feed price (USDC)
PREMIUM_DESK_FEED_PRICE_USDC=0.5

# ── Circle CCTP V2 rebalance (Base Sepolia → Ethereum Sepolia) ──
# Earn USDC on Base via x402; bridge native USDC to Sepolia for desk top-ups.
# Requires: TREASURY_WALLET_ADDRESS, X402_RPC_URL (Base), RPC_URL (Sepolia).
# Mint recipient is always the treasury address (never the operator).
# Admin routes (auth: X-ChronicleAI-Signature = KEEPERHUB_WEBHOOK_SECRET):
#   GET  /treasury/cctp/status
#   POST /treasury/cctp/rebalance   body: { "amountUsdc"?: number }
#   POST /treasury/cctp/resume
CCTP_REBALANCE_ENABLED=false
# Temporary multi-chain signer for approve/burn/mint until Para multi-chain is ready.
# Fund with Base ETH (+ Sepolia ETH for Mode A direct mint). Do NOT set mint to this key.
CCTP_OPERATOR_PRIVATE_KEY=
# Iris attestation API (sandbox for testnet)
CCTP_IRIS_BASE_URL=https://iris-api-sandbox.circle.com
# Prefer Circle Forwarding Service when fee quote succeeds (no local receiveMessage)
CCTP_USE_FORWARDING=true
# CCTP V2 contracts — same addresses on Base Sepolia + Ethereum Sepolia testnets
CCTP_TOKEN_MESSENGER=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
CCTP_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
# Domains: Base Sepolia = 6, Ethereum Sepolia = 0
CCTP_SOURCE_DOMAIN=6
CCTP_DEST_DOMAIN=0
# Fast Transfer finality threshold (≤1000). Standard is ≥2000.
CCTP_MIN_FINALITY_THRESHOLD=1000
# Policy knobs (human USDC unless noted)
CCTP_BASE_SAFETY_BUFFER_USDC=5
CCTP_REBALANCE_THRESHOLD_USDC=10
CCTP_REBALANCE_CHUNK_USDC=10
CCTP_REBALANCE_MAX_CHUNK_USDC=50
CCTP_MAX_IN_FLIGHT=1
CCTP_COOLDOWN_MS=900000
CCTP_MAX_FEE_USDC=0.05
CCTP_POLL_INTERVAL_MS=5000
CCTP_POLL_TIMEOUT_MS=1800000
CCTP_MINT_MAX_ATTEMPTS=3
CCTP_FORWARDING_FALLBACK_MS=600000
# Worker wake interval (resume in-flight + maybe start burn). Default 3m.
CCTP_REBALANCE_SCHEDULE_INTERVAL_MS=180000
# Demo only: allow desk starvation to break burn cooldown
CCTP_FORCE_ON_DESK_STARVATION=false
# Gas gates for burn (Base) and Mode A mint (Sepolia) — ETH human units
TREASURY_BASE_MIN_GAS_ETH=0.005
TREASURY_SEPOLIA_MIN_GAS_ETH=0.01
# Optional: verbose CCTP debug logs
# CCTP_DEBUG=true

# SMTP Email Dispatcher for Newsletter
# Recipients come from the email_subscribers table (POST /subscribers), not env.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=

# Community channel + Telegram free-plan ingest bridge (optional)
# ---------------------------------------------------------------------------
# TWO BOTS REQUIRED (Telegram bots never receive their own messages):
#
# 1) INGEST bot  — Chronicle webhook receiver (POST /telegram/webhook)
#    - @BotFather → /setprivacy → Disable (can_read_all_group_messages = true)
#    - Token: TELEGRAM_INGEST_BOT_TOKEN (or legacy TELEGRAM_BOT_TOKEN)
#
# 2) SEND bot    — posts CHRONICLE_INGEST from KeeperHub + alert broadcasts
#    - KeeperHub → Connections → Telegram uses this token
#    - Token: TELEGRAM_SEND_BOT_TOKEN
#    - Add both bots to the same private supergroup
#
# TELEGRAM_CHAT_ID       = destination for published alert/digest broadcasts
# TELEGRAM_INGEST_CHAT_ID = group that receives KeeperHub CHRONICLE_INGEST posts
#                          (defaults to TELEGRAM_CHAT_ID if unset)
TELEGRAM_INGEST_BOT_TOKEN=
TELEGRAM_SEND_BOT_TOKEN=
# Legacy alias for TELEGRAM_INGEST_BOT_TOKEN (still supported if INGEST unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1–256 chars: A-Za-z0-9_-  (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INGEST_CHAT_ID=
# Public HTTPS origin of this API (no path). Used to auto-register
# Telegram setWebhook on boot so you do not re-run a script every deploy.
# Example: https://your-app.herokuapp.com
PUBLIC_API_BASE_URL=

# Daily digest scheduler (in-process — does not require KeeperHub webhooks)
# Generates the previous completed UTC day via DigestRunHandler (idempotent).
# Default: enabled. Set false only if you rely solely on external triggers.
DIGEST_SCHEDULE_ENABLED=true
# How often to check whether yesterday's digest still needs generation (ms)
# DIGEST_SCHEDULE_INTERVAL_MS=900000

# Optional: live Gemini proxy integration test
V98STORE_API_KEY=

ALLOW_LIVE_API_TESTS=1
