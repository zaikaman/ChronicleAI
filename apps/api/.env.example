# Backend (server-only - never expose these values in frontend or client code)
# Loaded via packages/config loadServerEnv() and related process.env reads.

NODE_ENV=development
PORT=4000

# Required
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KEEPERHUB_WEBHOOK_SECRET=
FRONTEND_ORIGIN=http://localhost:5173

# Optional / tooling
SUPABASE_ANON_KEY=

# LLM Provider API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=

# Payments (x402 + MPP)
X402_FACILITATOR_URL=
# Preferred: MPP_SECRET (alias MPP_SECRET_KEY also accepted)
MPP_SECRET=
MPP_SECRET_KEY=
# Required for x402 createChallenge
TREASURY_WALLET_ADDRESS=
# Required for KeeperHub POST /keeperhub/revenue/route payouts
CREATOR_RECOVERY_WALLET=
# Currency-units → ETH for native transfers (default 0.000001)
REVENUE_ETH_PER_CURRENCY_UNIT=0.000001

# Smart Contract / Web3 Client Configuration
# Required for block monitoring, registry, sponsored watches, revenue routing
RPC_URL=
CHRONICLE_REGISTRY_ADDRESS=
PARA_WALLET_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# SMTP Email Dispatcher for Newsletter
# Recipients come from the email_subscribers table (POST /subscribers), not env.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=

# Optional: live Gemini proxy integration test
V98STORE_API_KEY=
