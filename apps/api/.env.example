# Backend (server-only - never expose these values in frontend or client code)
# Loaded via packages/config loadServerEnv() and related process.env reads.

NODE_ENV=development
PORT=4000

# Required
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KEEPERHUB_WEBHOOK_SECRET=
FRONTEND_ORIGIN=http://localhost:5173

# Optional / tooling
SUPABASE_ANON_KEY=

# LLM Provider API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=

# Payments (x402 + MPP)
# Facilitator settle endpoint base (e.g. https://api.cdp.coinbase.com/platform/v2/x402).
# When set, x402 settlements POST /settle to submit EIP-3009 transferWithAuthorization.
X402_FACILITATOR_URL=
# x402 EIP-712 domain: chain + USDC verifyingContract (defaults = Base Sepolia hackathon target).
# Base mainnet: X402_CHAIN_ID=8453, X402_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_CHAIN_ID=84532
X402_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Shared HMAC secret for MPP challenge verification
MPP_SECRET=
# Treasury: receives x402 payments + signs revenue-routing transfers.
# Set TREASURY_WALLET_PRIVATE_KEY; address is derived (ADDRESS optional, must match).
# With RPC_URL, the treasury key also pays gas for direct transferWithAuthorization
# when no facilitator is configured (signature alone never unlocks premium).
TREASURY_WALLET_PRIVATE_KEY=
TREASURY_WALLET_ADDRESS=
# Creator recovery payout RECIPIENT address (no private key; distinct from treasury)
CREATOR_RECOVERY_WALLET=
# Currency-units → ETH for native transfers (default 0.000001)
REVENUE_ETH_PER_CURRENCY_UNIT=0.000001

# Smart Contract / KeeperHub Write Path (P0 — only production write path)
# RPC_URL is still used for read-only block analysis + Chainlink ETH/USD.
RPC_URL=
CHRONICLE_REGISTRY_ADDRESS=
# KeeperHub Direct Execution / workflow trigger (material writes MUST go through this)
KEEPERHUB_API_BASE_URL=https://app.keeperhub.com
KEEPERHUB_API_KEY=
# Network slug for KeeperHub writes (default base-sepolia)
KEEPERHUB_NETWORK=base-sepolia
# Optional: imported workflow IDs (prefer Direct Execution when unset)
KEEPERHUB_WORKFLOW_PUBLISH_ALERT=
KEEPERHUB_WORKFLOW_PUBLISH_DIGEST=
KEEPERHUB_WORKFLOW_CREATE_SPONSORED_WATCH=
KEEPERHUB_WORKFLOW_PUBLISH_SPONSORED_REPORT=
KEEPERHUB_WORKFLOW_RECORD_PAYOUT=
KEEPERHUB_WORKFLOW_TRANSFER=
# Direct ethers sendTransaction is HARD-DISABLED in production.
# Set true only for local unit tests (never ship with this in demo/prod).
ALLOW_DIRECT_ETHERS_WRITES=false
# Para key: only used when ALLOW_DIRECT_ETHERS_WRITES=true (local tests).
PARA_WALLET_PRIVATE_KEY=
# Optional: Hardhat verify / contract tooling
ETHERSCAN_API_KEY=

# SMTP Email Dispatcher for Newsletter
# Recipients come from the email_subscribers table (POST /subscribers), not env.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=

# Optional: live Gemini proxy integration test
V98STORE_API_KEY=
