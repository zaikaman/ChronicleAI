{
  "name": "@chronicleai/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc && esbuild src/server.ts --bundle --platform=node --target=node22 --outfile=dist/server.js --format=esm --packages=external",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chronicleai/config": "workspace:*",
    "@chronicleai/db": "workspace:*",
    "@chronicleai/schemas": "workspace:*",
    "cors": "^2.8.5",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
