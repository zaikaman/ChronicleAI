{
  "name": "@chronicleai/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -b && esbuild src/server.ts --bundle --platform=node --target=node22 --outfile=dist/server.js --format=esm --packages=external --sourcemap",
    "build:heroku": "esbuild src/server.ts --bundle --platform=node --target=node22 --outfile=dist/server.js --format=esm --sourcemap --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --external:fsevents --external:*.node --log-level=warning",
    "start": "node dist/server.js",
    "type-check": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@chronicleai/config": "workspace:*",
    "@chronicleai/db": "workspace:*",
    "@chronicleai/schemas": "workspace:*",
    "@getpara/rest-sdk": "3.5.1",
    "@supabase/supabase-js": "^2.49.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "5.9.6",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
