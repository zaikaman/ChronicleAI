          "chatId": "-1004373075093",
          "message": "CHRONICLE_INGEST v1\n{\"kind\":\"event\",\"payload\":{\"chainId\":1,\"eventName\":\"Transfer\",\"address\":\"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48\",\"transactionHash\":\"{{@for-each-transfer:For Each Transfer.currentItem.transactionHash}}\",\"blockNumber\":\"{{@for-each-transfer:For Each Transfer.currentItem.blockNumber}}\",\"logIndex\":\"{{@for-each-transfer:For Each Transfer.currentItem.logIndex}}\",\"args\":{\"from\":\"{{@for-each-transfer:For Each Transfer.currentItem.args.from}}\",\"to\":\"{{@for-each-transfer:For Each Transfer.currentItem.args.to}}\",\"value\":\"{{@for-each-transfer:For Each Transfer.currentItem.args.value}}\"},\"protocol\":\"Circle\"}}",
