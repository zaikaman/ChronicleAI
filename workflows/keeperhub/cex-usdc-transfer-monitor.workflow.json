        "config": {
          "triggerType": "Schedule",
          "scheduleCron": "0 * * * *",
          "scheduleTimezone": "UTC"
        }
      }
    },
    {
      "id": "query-transfers",
      "type": "action",
      "position": { "x": 320, "y": 220 },
      "data": {
        "type": "action",
        "label": "Query USDC Transfers",
        "config": {
          "actionType": "web3/query-events",
          "network": "1",
          "contractAddress": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
          "eventName": "Transfer",
          "blockCount": "320",
          "abi": "[{\"type\":\"event\",\"name\":\"Transfer\",\"inputs\":[{\"indexed\":true,\"name\":\"from\",\"type\":\"address\"},{\"indexed\":true,\"name\":\"to\",\"type\":\"address\"},{\"indexed\":false,\"name\":\"value\",\"type\":\"uint256\"}]}]"
        }
      }
    },
    {
      "id": "for-each-transfer",
      "type": "action",
      "position": { "x": 560, "y": 220 },
      "data": {
        "type": "action",
        "label": "For Each Transfer",
        "config": {
          "actionType": "For Each",
          "arraySource": "{{@query-transfers:Query USDC Transfers.events}}",
          "maxIterations": "150"
        }
      }
    },
    {
      "id": "condition-large",
      "type": "action",
