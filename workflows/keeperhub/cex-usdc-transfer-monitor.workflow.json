        "config": {
          "actionType": "Condition",
          "condition": "{{@for-each-transfer:For Each Transfer.currentItem.args.value}} >= 500000000000"
        }
      }
    },
    {
      "id": "post-chronicle-telegram",
      "type": "action",
      "position": { "x": 1040, "y": 160 },
      "data": {
