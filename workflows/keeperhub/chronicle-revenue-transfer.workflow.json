      "type": "trigger",
      "position": {
        "x": 100,
        "y": 200
      },
      "data": {
        "type": "trigger",
        "label": "Manual / API Trigger",
        "config": {
          "triggerType": "Manual"
        }
      }
    },
    {
      "id": "transfer-usdc",
      "type": "action",
      "position": {
        "x": 420,
        "y": 200
      },
      "data": {
        "type": "action",
        "label": "Transfer USDC to payout recipient on configured rail",
        "config": {
          "actionType": "web3/transfer-token",
          "network": "{{@trigger-manual:Manual / API Trigger.network}}",
          "tokenConfig": "{{@trigger-manual:Manual / API Trigger.tokenConfig}}",
          "amount": "{{@trigger-manual:Manual / API Trigger.amount}}",
          "recipientAddress": "{{@trigger-manual:Manual / API Trigger.recipientAddress}}",
          "usePrivateMempool": false,
          "strict": true
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "trigger-manual",
      "target": "transfer-usdc"
    }
  ],
