{
  "version": 1,
  "exportedAt": "2026-07-11T00:00:00.000Z",
  "workflow": {
    "name": "ChronicleAI Revenue Transfer (USDC Payout)",
    "description": "Material write: ERC-20 USDC transfer for autonomous revenue routing and affiliate withdrawals. Chronicle supplies recipientAddress, amount, network, and tokenConfig at execution time. Ops revenue transfers use Ethereum Sepolia; affiliate withdrawals use the x402 rail (Base Sepolia by default)."
