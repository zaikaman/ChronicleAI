{
  "version": 1,
  "exportedAt": "2026-07-28T00:00:00.000Z",
  "workflow": {
    "name": "ChronicleAI USDC Mint/Burn Monitor (Telegram bridge)",
  "description": "NEWSPAPER ONLY. FREE TIER: Schedule hourly → Query verified Circle USDC Mint and Burn on Ethereum Sepolia → size filter (~$1M+) → Telegram CHRONICLE_INGEST. Chronicle classifies as stablecoin_mint / stablecoin_burn."
  },
  "nodes": [
    {
      "id": "trigger-schedule",
      "type": "trigger",
      "position": { "x": 80, "y": 220 },
      "data": {
        "type": "trigger",
        "label": "Every hour (free tier)",
        "config": {
          "triggerType": "Schedule",
          "scheduleCron": "15 * * * *",
          "scheduleTimezone": "UTC"
        }
      }
    },
    {
      "id": "query-mints",
      "type": "action",
      "position": { "x": 320, "y": 120 },
      "data": {
        "type": "action",
        "label": "Query USDC Mints",
        "config": {
          "actionType": "web3/query-events",
          "network": "11155111",
          "contractAddress": "0x1c7D4B196Cb0C7B01D743fBC6116a902379C7238",
          "eventName": "Mint",
          "blockCount": "320",
          "abi": "[{\"type\":\"event\",\"name\":\"Mint\",\"inputs\":[{\"indexed\":true,\"name\":\"minter\",\"type\":\"address\"},{\"indexed\":true,\"name\":\"to\",\"type\":\"address\"},{\"indexed\":false,\"name\":\"amount\",\"type\":\"uint256\"}]}]"
        }
      }
    },
    {
      "id": "for-each-mint",
      "type": "action",
      "position": { "x": 560, "y": 120 },
      "data": {
        "type": "action",
        "label": "For Each Mint",
        "config": {
          "actionType": "For Each",
          "arraySource": "{{@query-mints:Query USDC Mints.events}}",
          "maxIterations": "50"
        }
      }
    },
    {
      "id": "condition-mint-large",
      "type": "action",
      "position": { "x": 800, "y": 120 },
      "data": {
        "type": "action",
        "label": "Mint ≥ $1M USDC",
        "config": {
          "actionType": "Condition",
          "condition": "{{@for-each-mint:For Each Mint.currentItem.args.amount}} >= 1000000000000"
        }
      }
    },
    {
      "id": "post-mint-telegram",
      "type": "action",
      "position": { "x": 1040, "y": 80 },
      "data": {
        "type": "action",
        "label": "Telegram mint → Chronicle",
        "config": {
          "actionType": "telegram/send-message",
          "chatId": "-1004373075093",
        "message": "CHRONICLE_INGEST v1\n{\"kind\":\"event\",\"payload\":{\"chainId\":11155111,\"eventName\":\"Mint\",\"address\":\"0x1c7D4B196Cb0C7B01D743fBC6116a902379C7238\",\"transactionHash\":\"{{@for-each-mint:For Each Mint.currentItem.transactionHash}}\",\"blockNumber\":\"{{@for-each-mint:For Each Mint.currentItem.blockNumber}}\",\"logIndex\":\"{{@for-each-mint:For Each Mint.currentItem.logIndex}}\",\"args\":{\"minter\":\"{{@for-each-mint:For Each Mint.currentItem.args.minter}}\",\"to\":\"{{@for-each-mint:For Each Mint.currentItem.args.to}}\",\"amount\":\"{{@for-each-mint:For Each Mint.currentItem.args.amount}}\"},\"protocol\":\"Circle Sepolia USDC\"}}",
          "parseMode": "none"
        }
