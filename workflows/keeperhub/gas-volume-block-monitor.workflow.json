{
  "version": 1,
  "exportedAt": "2026-07-28T00:00:00.000Z",
  "workflow": {
    "name": "ChronicleAI Gas & Volume Block Monitor (Telegram bridge)",
  "description": "NEWSPAPER context (Ethereum Mainnet gas/volume). FREE TIER: Block Dispatcher every 300th Mainnet block ≈ ~60 min (~720 runs/mo) → Telegram → Chronicle block ingest. Mainnet gas is context-only; desk gas regime uses desk-gas-poll on Sepolia. Do NOT set blockInterval to 1."
  },
  "nodes": [
    {
      "id": "trigger-block",
      "type": "trigger",
      "position": {
        "x": 100,
        "y": 200
      },
      "data": {
        "type": "trigger",
        "label": "Every 300th Block (~60 min, free tier)",
        "config": {
          "triggerType": "Block",
          "network": "1",
          "blockInterval": 300
        }
      }
    },
    {
      "id": "post-chronicle-telegram",
      "type": "action",
      "position": {
        "x": 420,
        "y": 200
      },
      "data": {
        "type": "action",
        "label": "Telegram → Chronicle ingest bridge",
        "config": {
          "actionType": "telegram/send-message",
          "chatId": "YOUR_TELEGRAM_INGEST_CHAT_ID",
        "message": "CHRONICLE_INGEST v1\n{\"kind\":\"block\",\"payload\":{\"chainId\":1,\"blockNumber\":\"{{@trigger-block:Trigger.blockNumber}}\",\"blockHash\":\"{{@trigger-block:Trigger.blockHash}}\",\"timestamp\":\"{{@trigger-block:Trigger.timestamp}}\",\"sourceEventId\":\"kh-block-{{@trigger-block:Trigger.blockNumber}}\"}}",
          "parseMode": "none"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "trigger-block",
      "target": "post-chronicle-telegram"
    }
  ],
  "integrationBindings": []
}
