{
  "version": 1,
  "exportedAt": "2026-07-13T00:00:00.000Z",
  "workflow": {
    "name": "Chronicle Desk — Kill Switch (Flatten + Return)",
    "description": "Emergency desk shutdown on Ethereum Sepolia: best-effort Aave LINK withdraw (amount or max uint256), optional WETH→USDC fade swap when amountWeth>0 path is pre-sized by API, then transfer residual USDC desk→treasury. Judges highlight — keep live Sepolia tx link. Signer = KH desk wallet."
  },
  "nodes": [
    {
      "id": "trigger-manual",
      "type": "trigger",
      "position": {
        "x": 60,
        "y": 260
      },
      "data": {
        "type": "trigger",
        "label": "Manual / API Trigger",
        "config": {
          "triggerType": "Manual"
        }
      }
    },
    {
      "id": "should-withdraw",
      "type": "action",
      "position": {
        "x": 300,
        "y": 260
      },
      "data": {
        "type": "action",
        "label": "Should Withdraw Aave",
        "config": {
          "actionType": "Condition",
          "condition": "{{@trigger-manual.withdrawLink}} === 'true'",
          "conditionConfig": {
            "group": {
              "id": "withdraw-check",
              "logic": "AND",
              "rules": [
                {
                  "id": "rule-withdraw",
                  "operator": "===",
                  "leftOperand": "{{@trigger-manual.withdrawLink}}",
                  "rightOperand": "true"
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "aave-withdraw-link",
      "type": "action",
      "position": {
        "x": 560,
        "y": 120
      },
      "data": {
        "type": "action",
        "label": "Best-Effort Withdraw LINK",
        "config": {
          "actionType": "aave-v3/withdraw",
          "network": "11155111",
          "asset": "0xf8Fb3713D459D7C1018BD0A49D19b4C44290EBE5",
          "amount": "{{@trigger-manual.amountLink}}",
          "to": "{{@trigger-manual.deskAddress}}",
          "usePrivateMempool": true,
          "strict": true
        }
      }
    },
    {
      "id": "transfer-usdc",
      "type": "action",
      "position": {
        "x": 860,
        "y": 260
      },
      "data": {
        "type": "action",
        "label": "Transfer Residual USDC to Treasury",
        "config": {
          "actionType": "web3/transfer-token",
          "network": "11155111",
          "tokenConfig": "{\"mode\":\"custom\",\"customToken\":{\"address\":\"0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238\",\"symbol\":\"USDC\"}}",
          "amount": "{{@trigger-manual.amount}}",
          "recipientAddress": "{{@trigger-manual.treasuryAddress}}",
          "usePrivateMempool": true,
          "strict": true
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "trigger-manual",
      "target": "should-withdraw"
    },
    {
      "id": "e2",
      "type": "animated",
      "source": "should-withdraw",
      "target": "aave-withdraw-link",
      "sourceHandle": "true"
    },
    {
      "id": "e3",
      "source": "aave-withdraw-link",
      "target": "transfer-usdc"
    },
    {
      "id": "e4",
      "type": "animated",
      "source": "should-withdraw",
      "target": "transfer-usdc",
      "sourceHandle": "false"
    }
  ],
  "integrationBindings": []
}
