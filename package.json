{
  "name": "chronicleai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,yellow \"pnpm --filter @chronicleai/web dev\" \"pnpm --filter @chronicleai/api dev\"",
    "build": "turbo run type-check build --filter=!@chronicleai/contracts",
    "heroku-prebuild": "node scripts/heroku-prebuild.mjs",
    "heroku-postbuild": "pnpm --filter @chronicleai/api run build:heroku",
    "heroku-cleanup": "node scripts/heroku-cleanup.mjs",
    "type-check": "tsc -b --pretty false",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --project-id luhrtrmizufucvrxnzbs > packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@chronicleai/testing": "workspace:*",
    "@vitest/coverage-v8": "^3.1.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "overrides": {
      "zod@3.22.4": "3.25.76"
    }
  }
}
