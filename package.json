{
  "name": "chronicleai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,yellow \"pnpm --filter @chronicleai/web dev\" \"pnpm --filter @chronicleai/api dev\"",
    "build": "turbo run type-check build --filter=!@chronicleai/contracts",
    "heroku-prebuild": "node scripts/heroku-prebuild.mjs",
    "heroku-postbuild": "pnpm --filter @chronicleai/api run build:heroku",
    "heroku-cleanup": "node scripts/heroku-cleanup.mjs",
    "type-check": "tsc -b --pretty false",
    "check": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "verify:ci": "pnpm type-check && pnpm test && pnpm build",
    "test:watch": "vitest",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --project-id luhrtrmizufucvrxnzbs > packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@chronicleai/testing": "workspace:*",
    "@vitest/coverage-v8": "^3.1.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "overrides": {
      "zod@3.22.4": "3.25.76",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "uuid@<11.1.1": ">=11.1.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "axios@>=1.0.0 <1.18.0": ">=1.18.0",
      "axios@>=1.15.2 <1.18.0": ">=1.18.0",
      "axios@>=1.7.0 <1.18.0": ">=1.18.0",
      "axios@>=1.15.0 <1.18.0": ">=1.18.0",
      "axios@>=1.15.1 <1.18.0": ">=1.18.0",
      "axios@>=1.13.0 <1.18.0": ">=1.18.0",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4",
      "react-router@>=7.12.0 <8.3.0": ">=8.3.0",
      "postcss@<=8.5.17": ">=8.5.18"
    }
  }
}
