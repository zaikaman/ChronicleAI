# pnpm 10 blocks dependency lifecycle scripts unless explicitly allowed.
# esbuild (Vite), @swc/core (react-swc), keccak/secp256k1 (viem/wagmi), biome need postinstall.
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=@swc/core
onlyBuiltDependencies[]=@biomejs/biome
onlyBuiltDependencies[]=keccak
onlyBuiltDependencies[]=secp256k1
onlyBuiltDependencies[]=bufferutil
onlyBuiltDependencies[]=utf-8-validate
