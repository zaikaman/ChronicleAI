# ChronicleAI Environment Variables
# ==================================
#
# IMPORTANT: Keep server-only secrets OUT of frontend environments.
# Only VITE_* variables are safe to expose to the browser.

## ── Backend (server-only) ──────────────────────────────────────────
# These belong only in Heroku config vars or local backend .env files.
# Never add them to Vercel frontend environment variables.

PORT=4000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
KEEPERHUB_WEBHOOK_SECRET=
OPERATOR_AUTH_SECRET=

# LLM Provider API Keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

X402_FACILITATOR_URL=
MPP_SECRET_KEY=
TREASURY_WALLET_ADDRESS=
PUBLIC_FRONTEND_ORIGIN=http://localhost:5173

## ── Frontend (browser-safe) ────────────────────────────────────────
# These are safe to expose in the browser. Must be prefixed with VITE_.
# Add only to Vercel project environment settings.

VITE_API_BASE_URL=http://localhost:4000
