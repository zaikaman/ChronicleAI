# ChronicleAI Environment Variables
# ==================================
#
# IMPORTANT: Keep server-only secrets OUT of frontend environments.
# Only VITE_* variables are safe to expose to the browser.
#
# Copy to `.env` at the repo root (and/or apps/api/.env, apps/web/.env) as needed.

## ── Backend (server-only) ──────────────────────────────────────────
# These belong only in Heroku config vars or local backend .env files.
# Never add them to Vercel frontend environment variables.

NODE_ENV=development
PORT=4000

# Required for API boot
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional public/anon key (client or tooling; not used by server loadServerEnv)
SUPABASE_ANON_KEY=
# Min 16 chars; required for KeeperHub webhook signature verification
KEEPERHUB_WEBHOOK_SECRET=
# Required CORS origin for the web app
FRONTEND_ORIGIN=http://localhost:5173

# LLM Provider API Keys (optional per-provider; at least one recommended for alerts)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=

# Payments
# x402 facilitator endpoint (optional)
X402_FACILITATOR_URL=
# x402 EIP-712 domain: chain + USDC verifyingContract (defaults = Base Sepolia).
# Base mainnet: X402_CHAIN_ID=8453, X402_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_CHAIN_ID=84532
X402_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Shared HMAC secret for MPP challenge verification
MPP_SECRET=
# HMAC secret for premium access receipts (min 16 chars). Falls back to KEEPERHUB_WEBHOOK_SECRET.
PREMIUM_ACCESS_SECRET=
# Treasury wallet: receives x402 payments AND signs revenue-routing transfers.
# Prefer TREASURY_WALLET_PRIVATE_KEY — address is derived automatically.
# TREASURY_WALLET_ADDRESS is optional; if set it must match the key.
TREASURY_WALLET_PRIVATE_KEY=
TREASURY_WALLET_ADDRESS=
# Creator recovery payout RECIPIENT (not a signing key). Distinct from treasury.
CREATOR_RECOVERY_WALLET=
# Currency-units → native ETH scale for payout transfers (default 1e-6)
REVENUE_ETH_PER_CURRENCY_UNIT=0.000001

# Smart Contract / KeeperHub Write Path (P0 — only production write path)
# RPC_URL is still used for read-only block analysis + Chainlink ETH/USD.
RPC_URL=
CHRONICLE_REGISTRY_ADDRESS=
# KeeperHub Direct Execution / workflow trigger (material writes MUST go through this)
KEEPERHUB_API_BASE_URL=https://app.keeperhub.com
KEEPERHUB_API_KEY=
# Network slug for KeeperHub writes (default base-sepolia)
KEEPERHUB_NETWORK=base-sepolia
# Optional: imported workflow IDs (prefer Direct Execution when unset)
KEEPERHUB_WORKFLOW_PUBLISH_ALERT=
KEEPERHUB_WORKFLOW_PUBLISH_DIGEST=
KEEPERHUB_WORKFLOW_CREATE_SPONSORED_WATCH=
KEEPERHUB_WORKFLOW_PUBLISH_SPONSORED_REPORT=
KEEPERHUB_WORKFLOW_RECORD_PAYOUT=
KEEPERHUB_WORKFLOW_TRANSFER=
# Direct ethers sendTransaction is HARD-DISABLED in production.
# Set true only for local unit tests (never ship with this in demo/prod).
ALLOW_DIRECT_ETHERS_WRITES=false
# Para key: only used when ALLOW_DIRECT_ETHERS_WRITES=true (local tests).
PARA_WALLET_PRIVATE_KEY=
# Optional: Hardhat verify / contract tooling
ETHERSCAN_API_KEY=

# SMTP Email Dispatcher for Newsletter digests
# Recipients come from the email_subscribers table (POST /subscribers), not env.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=

## ── Frontend (browser-safe) ────────────────────────────────────────
# These are safe to expose in the browser. Must be prefixed with VITE_.
# Add only to Vercel project environment settings (or apps/web/.env).

VITE_API_BASE_URL=http://localhost:4000
# Optional Supabase browser client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: MPP machine client shared secret (must match server MPP_SECRET)
VITE_MPP_CLIENT_SECRET=

## ── Local tests / tooling (optional) ───────────────────────────────
# Contract tests against a running API
TEST_API_URL=http://localhost:4000
TEST_KEEPERHUB_SECRET=
API_BASE_URL=http://localhost:4000
# Live Gemini proxy integration test only
V98STORE_API_KEY=
